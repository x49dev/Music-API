# Environment Configuration
# Copy this file to .env and fill in your values

# Application Environment
NODE_ENV=development

# Server Port
PORT=3000

# Database URL (SQLite for development, PostgreSQL for production)
# Examples:
#   sqlite:./data.db
#   postgresql://user:pass@localhost:5432/music_api
DATABASE_URL=sqlite:./data.db

# Redis URL (optional, for production caching)
# REDIS_URL=redis://localhost:6379

# YouTube Data API Key (optional, for fallback provider)
# YOUTUBE_API_KEY=your_api_key_here

# Cache TTL Settings (in seconds)
CACHE_TTL_SEARCH=300
CACHE_TTL_TRACK=3600
CACHE_TTL_PLAYLIST=3600
CACHE_TTL_ARTIST=86400

# Logging Level
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# yt-dlp Path (default assumes it's in PATH)
YTDLP_PATH=yt-dlp

# Docker PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=music_api